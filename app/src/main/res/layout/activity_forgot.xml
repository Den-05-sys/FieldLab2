<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1117"
    android:orientation="vertical"
    android:padding="24dp">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recuperar acceso"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="La recuperación por correo aún no está configurada. Contacta al administrador para restablecer tu acceso."
        android:textColor="#9AA4B2" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_send_reset"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#FFD54F"
        android:text="Volver al inicio de sesión"
        android:textColor="#0E1117"
        app:cornerRadius="16dp" />
</LinearLayout>