<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1117"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout_simulator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1F2B"
        app:tabIndicatorColor="#FFD54F"
        app:tabSelectedTextColor="#FFD54F"
        app:tabTextColor="#9AA4B2" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_simulator"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
